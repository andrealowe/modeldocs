02_model_development.ipynb
*.ipynb

# Streamlit app (separate deployment)
streamlit-app.py
app.sh
requirements-app.txt

# Documentation
*.md
Model-Card-Template.md

# Monitoring scripts (run separately as jobs)
monitoring/

# Launcher scripts (separate deployment)
launcher_scripts/

# ETL scripts and flows (data preprocessing only)
ETL-scripts/
flow.py
flow_v2.py

# Results and outputs
results/

# IDE and version control
.ipynb_checkpoints/
__pycache__/
.claude/
.Trash-*/
.git/
.gitignore

# Domino project files (not needed in container)
.dominoignore
.dominoresults
.domino/

